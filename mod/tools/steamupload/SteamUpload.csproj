<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release helper: publishes the staged mod folder to Steam Workshop (Timberborn app 1062090).
       Build: dotnet build mod\tools\steamupload\SteamUpload.csproj -c Release -m:1
       Run: SteamUpload.exe probe   |   SteamUpload.exe <upload-ready-folder> <change-note.txt> [itemId]
       Steam must be running and logged in; the Workshop legal agreement is accepted by the
       account owner on first publish. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SteamUpload</AssemblyName>
    <RootNamespace>Mwp.SteamUpload</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Plugins\x86_64\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
